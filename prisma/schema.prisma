// Schéma MVP : catalogue, comptes, commandes, factures, event log.
// Product = l'item générique du catalogue (ce que le client cherche, ex. "Recharge 20Go").
// Offer = la cotation d'un Provider donné sur un Product donné (son prix, sa note, ses ventes) —
// plusieurs fournisseurs peuvent coter le même Product, le client choisit parmi les offres.
// Chaque commande génère des Event (traçabilité de bout en bout, quel que soit le parcours).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JourneyType {
  NATIVE
  HYBRID
  EXTERNAL
}

enum ConsumptionType {
  UNIT
  SUBSCRIPTION
  USAGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  EXPIRED
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  DOWN
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// Sections du back-office qu'un compte staff (User.isAdmin = true) peut utiliser.
// isAdmin reste la porte d'entrée du panneau ; AdminPermission décide de ce qu'il
// y voit. USERS est le scope "super-admin" : lui seul permet de gérer isAdmin et
// les permissions des autres comptes (voir routes/admin.ts).
enum AdminScope {
  PROVIDERS
  CATALOG
  ORDERS
  COMMISSIONS
  ANALYTICS
  USERS
}

enum CommissionType {
  PERCENTAGE // commissionValue en points de base (500 = 5,00 %)
  FIXED      // commissionValue en centimes
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  // Opérateur de la plateforme (toi) : accès aux revenus de commission,
  // invisibles pour les clients. Pas de self-service — flag posé manuellement
  // ou via ADMIN_EMAIL au seed.
  isAdmin     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  orders      Order[]
  memberships Membership[]
  cartItems   CartItem[]
  adminPermissions AdminPermission[]
}

// Une ligne = un scope accordé à un compte staff. Ajoutée/retirée uniquement par
// un compte détenant le scope USERS (voir PATCH /admin/users/:id/permissions).
model AdminPermission {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  scope     AdminScope
  createdAt DateTime   @default(now())

  @@unique([userId, scope])
}

// Compte B2B : plusieurs utilisateurs (Membership) rattachés à une même
// organisation, pour la facturation consolidée des commandes passées
// pour le compte de l'entreprise (Order.organizationId).
model Organization {
  id          String       @id @default(uuid())
  name        String
  vatNumber   String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
  orders      Order[]
}

model Membership {
  id             String         @id @default(uuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
}

model Provider {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  status    ProviderStatus @default(ACTIVE)
  // connectorKey identifie quel connecteur (src/connectors) traite ce fournisseur
  connectorKey String
  // Politique de commission plateforme, propre à chaque fournisseur (négociée
  // individuellement) — jamais exposée au client, prélevée sur le prix qu'il paie.
  commissionType  CommissionType @default(PERCENTAGE)
  commissionValue Int            @default(500) // 5,00 % par défaut

  // Config du connecteur REST générique (connectorKey = "generic-rest") — sans
  // cela, connectorKey doit pointer vers un connecteur codé en dur (src/connectors).
  // apiKey n'est jamais renvoyée en clair par l'API admin (voir routes/admin.ts) :
  // c'est un secret write-only, comme n'importe quelle gestion de clé API.
  apiBaseUrl        String?
  apiKey            String?
  apiAuthHeader     String  @default("Authorization")
  apiAuthPrefix     String  @default("Bearer ")
  apiOrderPath      String  @default("/orders")
  // Chemins (dot-path simple, ex. "data.status") pour lire la réponse du
  // fournisseur — évite d'écrire un connecteur dédié pour un JSON légèrement
  // différent du contrat par défaut documenté dans le README.
  apiStatusField    String  @default("status")
  apiOrderIdField   String  @default("provider_order_id")
  apiConfirmedValue String  @default("confirmed")
  // GET {apiBaseUrl}{apiCatalogPath} → tableau JSON [{ id, name, description?,
  // category?, price, currency, image_url? }, ...], utilisé par "Importer le
  // catalogue" (voir routes/admin.ts) pour créer/mettre à jour Product+Offer.
  apiCatalogPath    String  @default("/catalog")

  createdAt DateTime       @default(now())
  offers    Offer[]
  orders    Order[]
}

// Taxonomie DigiGo : Category (Recharges, Argent & paiements, ...) > Subcategory
// (Recharge téléphonique, Transfert d'argent, ...) > Product. Le client navigue
// et filtre selon cette hiérarchie ; jamais selon le fournisseur qui traite la
// commande en coulisses (le fournisseur reste sur Provider/Offer, en back-office).
model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  icon          String        @default("🔹")
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(uuid())
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  name       String
  slug       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  products   Product[]

  @@unique([categoryId, slug])
}

model Product {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  // Legacy : catégorie à plat, conservée le temps de migrer les pages client
  // vers la hiérarchie Category/Subcategory ci-dessus (voir subcategoryId).
  category        String
  // Nullable pendant la transition : un produit non encore reclassé retombe sur
  // le champ `category` legacy plutôt que de casser l'affichage.
  subcategory     Subcategory?    @relation(fields: [subcategoryId], references: [id])
  subcategoryId   String?
  description     String
  // Posée manuellement ou par "Importer le catalogue" (jamais écrasée si déjà
  // définie : un produit peut être vendu par plusieurs fournisseurs, la première
  // image reçue reste la référence plutôt que de changer selon le fournisseur importé).
  imageUrl        String?
  currency        String          @default("EUR")
  consumptionType ConsumptionType @default(UNIT)
  journeyType     JourneyType     @default(NATIVE)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  offers          Offer[]
  orders          Order[]
}

// Cotation d'un Provider sur un Product : c'est cette ligne, pas le Product,
// qui porte le prix — plusieurs fournisseurs peuvent coter le même produit,
// le client compare et choisit (voir GET /products/:slug).
model Offer {
  id              String   @id @default(uuid())
  product         Product  @relation(fields: [productId], references: [id])
  productId       String
  provider        Provider @relation(fields: [providerId], references: [id])
  providerId      String
  price           Int      // en centimes
  rating          Float?
  salesCount      Int      @default(0)
  deliverySeconds Int?
  kycVerified     Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  orders          Order[]
  cartItems       CartItem[]

  @@unique([productId, providerId])
}

// Panier persisté côté serveur : une ligne par offre ajoutée par un client
// (auth requise, comme pour l'achat immédiat). Un ajout répété de la même
// offre incrémente `quantity` plutôt que de dupliquer une ligne (voir
// @@unique ci-dessous, utilisé en upsert par POST /cart).
model CartItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  offer     Offer    @relation(fields: [offerId], references: [id])
  offerId   String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, offerId])
}

model Order {
  id                 String        @id @default(uuid())
  user               User          @relation(fields: [userId], references: [id])
  userId             String
  // Rattachement optionnel à une organisation : commande passée pour le compte
  // de l'entreprise (B2B, facturation consolidée) plutôt qu'à titre personnel (B2C).
  organization       Organization? @relation(fields: [organizationId], references: [id])
  organizationId     String?
  product            Product       @relation(fields: [productId], references: [id])
  productId          String
  // Offre choisie par le client (fige le fournisseur ET le prix cotés au moment
  // de la commande, même si l'offre change ou est désactivée par la suite).
  offer              Offer         @relation(fields: [offerId], references: [id])
  offerId            String
  provider           Provider      @relation(fields: [providerId], references: [id])
  providerId         String
  status             OrderStatus   @default(PENDING)
  amount             Int
  // Quantité de l'offre commandée (panier multi-articles) ; `amount` est déjà
  // le total (offer.price * quantity), ce champ ne sert qu'à l'afficher
  // correctement sur la facture (colonne "Qté") — jamais recalculé depuis lui.
  quantity           Int           @default(1)
  // Commission plateforme prélevée sur `amount`, calculée à la création selon
  // la politique du fournisseur (Provider.commissionType/commissionValue).
  // Jamais renvoyée par les routes accessibles aux clients (voir routes/orders.ts) —
  // uniquement consultable par un admin via GET /admin/commissions.
  platformFee        Int           @default(0)
  currency           String        @default("EUR")
  journeyType        JourneyType
  providerOrderId    String?       // id renvoyé par le fournisseur, si natif/hybride
  idempotencyKey     String        @unique
  createdAt          DateTime      @default(now())
  confirmedAt        DateTime?
  invoice            Invoice?
  events             Event[]
}

model Invoice {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @unique
  // Numéro légal séquentiel, attribué par Postgres (jamais recalculé en JS —
  // évite toute collision entre factures émises en même temps). Formaté à
  // l'affichage en FA-{année}-{numéro sur 6 chiffres}, cf. src/billing/invoiceNumber.ts.
  sequenceNumber Int @unique @default(autoincrement())
  amount    Int
  // Taux de TVA en points de base (2000 = 20 %) ; null si non applicable
  // (ex. franchise en base) — jamais un taux inventé par défaut.
  vatRate   Int?
  currency  String   @default("EUR")
  status    String   @default("ISSUED") // ISSUED, REFUNDED
  issuedAt  DateTime @default(now())
}

// Journal d'événements immuable : source de vérité pour la traçabilité et le support.
model Event {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  type      String   // ORDER_CREATED, PROVIDER_CALL_ATTEMPT, PROVIDER_CONFIRMED, PROVIDER_FAILED, REFUND_ISSUED...
  payload   Json?
  createdAt DateTime @default(now())
}
